# Rendered at container start into /etc/nginx/conf.d/default.conf; only ${API_BASE} is substituted.
server {
    listen 9001;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Files are gzipped at build time; on-the-fly gzip covers anything that is not.
    gzip_static on;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json application/wasm
               application/octet-stream image/svg+xml font/ttf font/otf;

    # Flutter's output names (main.dart.js, flutter_bootstrap.js, canvaskit/…) are not content-hashed, so a long cache
    # would pin tills to an old build after a deploy. Revalidating costs a 304.
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # The app reads its default API server from this bundled asset (lib/core/api/api_client.dart, ServerConfig);
    # answering it from the environment lets one image point at any backend.
    location = /assets/.env {
        default_type text/plain;
        return 200 "API_BASE=${API_BASE}\n";
    }

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # A missing build file is a real 404, not the app shell.
    location ~ ^/(assets|canvaskit|icons)/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
